
{
  "manifest_version": 3,
  "name": "RentGuard AI",
  "version": "0.1.0",
  "description": "Check rental listings for potential issues.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "RentGuard AI",
    "default_popup": "popup.html"
  }
}
